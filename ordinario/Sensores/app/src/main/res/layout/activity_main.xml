<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensores del dispositivo"
            android:textColor="#16233D"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:text="Lecturas actualizadas en tiempo real"
            android:textColor="#617087"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_sensor"
            android:padding="16dp"
            android:text="Acelerómetro"
            android:textColor="#2457A6"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/valorAcelerometro"
            style="@style/ValorSensor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/fondo_sensor"
            android:padding="16dp"
            android:text="Giroscopio"
            android:textColor="#2457A6"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/valorGiroscopio"
            style="@style/ValorSensor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/fondo_sensor"
            android:padding="16dp"
            android:text="Magnetómetro"
            android:textColor="#2457A6"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/valorMagnetometro"
            style="@style/ValorSensor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/fondo_sensor"
            android:padding="16dp"
            android:text="Sensor de luz"
            android:textColor="#2457A6"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/valorLuz"
            style="@style/ValorSensor" />
    </LinearLayout>
</ScrollView>

